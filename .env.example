# ==============================================================================
# n8n Social OmniFlow - Environment Configuration Template
# ==============================================================================

# --- AI & Application Hosting ---
GEMINI_API_KEY="your_gemini_api_key_here"
APP_URL="http://localhost:3000"
PORT=3000
HOST="0.0.0.0"

# --- n8n Core Engine (Self-Hosted Docker / Local) ---
N8N_HOST="localhost"
N8N_PORT=5678
N8N_PROTOCOL="http"
N8N_ENCRYPTION_KEY="replace_with_a_secure_random_32_char_hex_string"
WEBHOOK_URL="http://localhost:5678/"
N8N_DEFAULT_BINARY_DATA_MODE="filesystem"
N8N_MCP_MANAGED_BY_ENV="true"
N8N_MCP_ACCESS_ENABLED="true"

# --- Model Context Protocol (MCP) Integration ---
# Enables Cursor, VS Code, Claude, and Gemini coding agents to connect to n8n
N8N_MCP_ENDPOINT="http://localhost:5678/mcp-server/http"
N8N_MCP_TOKEN="optional_personal_access_token_if_using_api_key_auth"

# --- Webhook Authentication & Security ---
OMNIFLOW_WEBHOOK_SECRET="replace_with_strong_random_token"

# --- TikTok Open API v2 Credentials ---
# Scopes required: video.upload, video.publish, user.info.basic
TIKTOK_CLIENT_KEY="your_tiktok_client_key"
TIKTOK_CLIENT_SECRET="your_tiktok_client_secret"
TIKTOK_ACCESS_TOKEN="your_tiktok_access_token"

# --- YouTube Data API v3 Credentials ---
# Scopes required: https://www.googleapis.com/auth/youtube.upload
YOUTUBE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="your_google_client_secret"
YOUTUBE_REFRESH_TOKEN="your_youtube_refresh_token"

# --- Meta Instagram Graph API v21.0 Credentials ---
# Scopes required: instagram_basic, instagram_content_publish, pages_show_list
INSTAGRAM_ACCOUNT_ID="your_instagram_business_account_id"
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
INSTAGRAM_USER_ACCESS_TOKEN="your_long_lived_instagram_user_access_token"

# --- Notifications & Dispatch Alerts ---
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your_webhook_id/your_webhook_token"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T00/B00/XXXX"
